diff --git a/app/src/test/java/com/irvingguerra/litedash/ObdWidgetsTest.kt b/app/src/test/java/com/irvingguerra/litedash/ObdWidgetsTest.kt
new file mode 100644
index 0000000..4825034
--- /dev/null
+++ b/app/src/test/java/com/irvingguerra/litedash/ObdWidgetsTest.kt
@@ -0,0 +1,23 @@
+package com.irvingguerra.litedash
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ObdWidgetsTest {
+    @Test
+    fun cadaWidgetObdSePuedeAgregar() {
+        for (type in OBD_WIDGETS) {
+            val spec = TileSpecs.firstOrNull { it.type == type }
+            assertNotNull("$type sin TileSpec", spec)
+            // El tamaño con que se agrega respeta su mínimo.
+            assertTrue(type, spec!!.initialSize.first >= spec.limits.minWidth && spec.initialSize.second >= spec.limits.minHeight)
+        }
+    }
+
+    @Test
+    fun losTiposNoSeRepiten() {
+        assertEquals(TileSpecs.size, TileSpecs.map { it.type }.toSet().size)
+    }
+}
